    "channel": {
      "const": "detect.expert/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "documentKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_:.-]+$"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?:(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*|\\[[0-9a-f:.]{2,45}\\])$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Saturating counter. The runtime validator saturates larger finite integers to the maximum."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "nonNegInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "timestampMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
