    "coverageState": {
      "type": "string",
      "enum": [
        "active",
        "partial",
        "late-start",
        "paused",
        "unsupported",
        "no-access",
        "degraded"
      ]
    },
    "countQuality": {
      "type": "string",
      "enum": [
        "exact",
        "sampled",
        "lower-bound"
      ]
