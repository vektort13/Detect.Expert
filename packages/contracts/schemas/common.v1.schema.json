      "type": "string",
      "enum": [
        "active",
        "paused",
        "degraded",
        "stopped"
      ]
    },
    "bridgeStopReason": {
      "type": "string",
      "enum": [
        "protocol-mismatch",
        "revoked",
        "scope-changed",
        "unload"
      ]
