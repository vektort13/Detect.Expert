{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detect-expert:contracts:bridge-control:v1",
  "title": "BridgeControl v1 - service worker -> ISOLATED bridge (chrome.tabs.sendMessage to one document)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "command"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "urn:detect-expert:contracts:common:v1#/$defs/schemaVersion"
        },
        "type": {
          "const": "bridge-control"
        },
        "command": {
          "enum": [
            "pause",
            "resume",
            "stop"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "command",
        "resetId"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "urn:detect-expert:contracts:common:v1#/$defs/schemaVersion"
        },
        "type": {
          "const": "bridge-control"
        },
        "command": {
          "const": "reset"
        },
        "resetId": {
          "$ref": "urn:detect-expert:contracts:common:v1#/$defs/id"
        }
      }
    }
  ]
}
