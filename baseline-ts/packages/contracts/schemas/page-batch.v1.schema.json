{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detect-expert:contracts:page-batch:v1",
  "title": "PageBatch v1 — ISOLATED -> service worker; untrusted input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "sensorBootId",
    "bridgeSessionId",
    "batchSeq",
    "observations",
    "coverageDelta"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:detect-expert:contracts:common:v1#/$defs/schemaVersion"
    },
    "type": {
      "const": "sensor-events"
    },
    "sensorBootId": {
      "$ref": "urn:detect-expert:contracts:common:v1#/$defs/id"
    },
    "bridgeSessionId": {
      "$ref": "urn:detect-expert:contracts:common:v1#/$defs/id"
    },
    "batchSeq": {
      "$ref": "urn:detect-expert:contracts:common:v1#/$defs/seq"
    },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "urn:detect-expert:contracts:common:v1#/$defs/pageObservation"
      }
    },
    "coverageDelta": {
      "$ref": "urn:detect-expert:contracts:common:v1#/$defs/coverageFlags"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "coverageDelta": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ]
}
