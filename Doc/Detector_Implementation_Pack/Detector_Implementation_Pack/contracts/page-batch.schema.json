          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "countQuality": {
            "enum": [
              "exact",
              "sampled",
              "lower-bound"
            ]
          },
          "phase": {
            "enum": [
              "attempted",
              "returned-sync",
              "threw-sync",
              "async-returned",
              "settlement-unobserved"
            ]
          },
          "signalCodes": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "enum": [
                "api-use",
                "readback-after-text",
                "offline-render",
                "numeric-diversity",
                "known-numeric-pattern",
                "local-multi-port",
                "unique-subdomains",
                "early-observation",
                "late-start",
                "hook-failed",
                "sample-budget-exceeded"
              ]
            }
          },
          "intervalBucket": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
