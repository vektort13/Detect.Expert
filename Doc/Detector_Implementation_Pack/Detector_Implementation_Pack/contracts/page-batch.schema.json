{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detector:page-batch:v1",
  "title": "Proposed page batch v1; untrusted input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "sensorBootId",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "sensor-events"
    },
    "sensorBootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "techniqueId",
          "count",
          "countQuality",
          "phase",
          "signalCodes"
        ],
        "properties": {
          "techniqueId": {
